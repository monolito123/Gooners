    "example:encrypt": "node examples/02-hybrid-encrypt.ts",
    "example:pack": "node examples/03-pack-and-send.ts",
    "demo": "node examples/04-chat-demo.ts",
    "bench": "node examples/05-benchmark.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@scure/bip39": "2.4.0",
    "protobufjs": "8.8.1"
  },
  "devDependencies": {
    "@hpke/core": "1.9.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
