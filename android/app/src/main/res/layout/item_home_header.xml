<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qOpen"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Abrir"
            app:icon="@drawable/ic_folder"
            app:iconGravity="top"
            app:iconPadding="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qScan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:text="Digitalizar"
            app:icon="@drawable/ic_camera"
            app:iconGravity="top"
            app:iconPadding="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qCreate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:text="Criar"
            app:icon="@drawable/ic_page_add"
            app:iconGravity="top"
            app:iconPadding="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qImages"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Fotos→PDF"
            app:icon="@drawable/ic_image"
            app:iconGravity="top"
            app:iconPadding="2dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/deviceCard"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos os documentos do aparelho"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF, Word, Excel, PowerPoint, eBooks e mais"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="Recentes"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
</LinearLayout>
