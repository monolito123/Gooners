<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GPDF" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#4F46E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E7FF</item>
        <item name="colorOnPrimaryContainer">#1E1B4B</item>
        <item name="colorSecondary">#6366F1</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E0E7FF</item>
        <item name="colorOnSecondaryContainer">#1E1B4B</item>
        <item name="colorTertiary">#DC2626</item>
        <item name="android:colorBackground">#F7F7F8</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:statusBarColor">#F7F7F8</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m" xmlns:tools="http://schemas.android.com/tools">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35" xmlns:tools="http://schemas.android.com/tools">true</item>
        <item name="android:navigationBarColor">#F7F7F8</item>
    </style>

    <style name="Theme.GPDF.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.GPDF.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#A5B4FC</item>
        <item name="colorOnPrimary">#1E1B4B</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="ToolButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>
</resources>
