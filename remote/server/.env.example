# OmniAssist signaling server — copy to .env and fill in.

# HTTP/WSS listen port (behind a TLS terminator in production; see docker-compose).
PORT=8080

# Secret used to sign JWTs. Generate: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued session token is valid.
JWT_TTL_SECONDS=3600

# Session lifetimes.
SESSION_TTL_SECONDS=7200          # max duration of a paired session
PAIRING_TTL_SECONDS=120           # time a device's PIN stays valid before rotation
PIN_ROTATE_SECONDS=30             # attended-mode PIN rotation interval

# Comma-separated allowed Origins for the web controller (CORS / WS origin check).
ALLOWED_ORIGINS=https://assist.example.com,http://localhost:5173

# Public TURN/STUN config advertised to clients (Coturn).
TURN_URL=turn:turn.example.com:3478
TURN_STATIC_SECRET=change-me-coturn-shared-secret   # must equal Coturn's static-auth-secret
TURN_CRED_TTL_SECONDS=600
STUN_URL=stun:turn.example.com:3478

# Max concurrent sessions (protects the Always Free box).
MAX_SESSIONS=200
