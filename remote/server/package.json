{
  "name": "omniassist-server",
  "version": "0.1.0",
  "private": true,
  "description": "OmniAssist signaling & session server (signaling + NAT traversal only; never sees media).",
  "license": "SEE TERMS_OF_USE.md",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/flow.mjs"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3"
  }
}
