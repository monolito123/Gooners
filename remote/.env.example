# docker-compose variables (copy to remote/.env). These feed Coturn.
# The signaling server reads its own settings from server/.env (env_file).
# Keep TURN_STATIC_SECRET identical here and in server/.env.

TURN_PUBLIC_IP=203.0.113.10         # the OCI instance's reserved public IP
TURN_REALM=turn.example.com
TURN_STATIC_SECRET=change-me-coturn-shared-secret
