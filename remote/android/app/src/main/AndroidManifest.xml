<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="false"
        android:label="OmniAssist"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniAssist">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="OmniAssist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The mandatory consent modal. Launched for each attended session. -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OmniAssist" />

        <!--
          Foreground service that owns screen capture and the WebRTC session.
          foregroundServiceType=mediaProjection is required on Android 10+; the
          OS will not let it capture without an active foreground notification.
        -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
