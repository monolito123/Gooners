{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.goonerspay.example/nostr/schemas/kind-7710.payment-request.schema.json",
  "title": "Kind 7710: payment request (signed by an authorized merchant device)",
  "allOf": [{ "$ref": "common.schema.json#/$defs/event" }],
  "properties": {
    "kind": { "const": 7710 },
    "tags": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/merchantTag" },
        { "contains": { "type": "array", "prefixItems": [{ "const": "expiration" }, { "pattern": "^[0-9]+$" }] } }
      ]
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": ["v", "request_id", "amount", "methods", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "request_id": { "$ref": "common.schema.json#/$defs/ulid" },
        "amount": { "$ref": "common.schema.json#/$defs/money" },
        "description": { "type": "string", "maxLength": 280 },
        "methods": { "type": "array", "minItems": 1, "items": { "enum": ["card_present", "card", "pix", "payment_link"] } },
        "checkout_url": { "type": "string", "format": "uri" },
        "pix_br_code": { "type": "string", "pattern": "^000201" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
