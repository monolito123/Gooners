{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.goonerspay.example/nostr/schemas/kind-7711.receipt.schema.json",
  "title": "Kind 7711: payment receipt (signed by the platform receipts key, delivered gift-wrapped)",
  "allOf": [{ "$ref": "common.schema.json#/$defs/event" }],
  "properties": {
    "kind": { "const": 7711 },
    "tags": { "$ref": "common.schema.json#/$defs/merchantTag" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": ["v", "receipt_id", "payment_intent_id", "merchant", "amount", "method", "installments", "settlement_date"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "receipt_id": { "type": "string", "pattern": "^rcpt_[0-9A-HJKMNP-TV-Z]{26}$" },
        "payment_intent_id": { "$ref": "common.schema.json#/$defs/ulid" },
        "merchant": {
          "type": "object",
          "required": ["id", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/ulid" },
            "name": { "type": "string" },
            "cnpj": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}$" },
            "address": { "type": "string" },
            "nip05": { "type": "string" }
          }
        },
        "amount": { "$ref": "common.schema.json#/$defs/money" },
        "method": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["card", "pix"] },
            "brand": { "enum": ["visa", "mastercard", "elo", "amex", "hipercard"] },
            "funding": { "enum": ["credit", "debit", "prepaid"] },
            "last4": { "type": "string", "pattern": "^[0-9]{4}$" },
            "application_label": { "type": "string" },
            "aid": { "type": "string", "pattern": "^[0-9A-F]{10,32}$" },
            "entry_mode": { "enum": ["contactless", "chip", "ecommerce", "credential_on_file"] },
            "cvm": { "enum": ["no_cvm", "online_pin", "consumer_device_cvm", "signature"] },
            "end_to_end_id": { "type": "string", "pattern": "^E[0-9]{8}[0-9]{12}[A-Za-z0-9]{11}$" }
          },
          "not": { "anyOf": [{ "required": ["pan"] }, { "required": ["number"] }, { "required": ["track2"] }] }
        },
        "authorization": {
          "type": "object",
          "required": ["code", "rrn", "approved_at"],
          "properties": {
            "code": { "type": "string" },
            "rrn": { "type": "string", "pattern": "^[0-9A-Z]{12}$" },
            "stan": { "type": "string", "pattern": "^[0-9]{6}$" },
            "terminal_id": { "type": "string" },
            "approved_at": { "type": "string", "format": "date-time" }
          }
        },
        "installments": {
          "type": "object",
          "required": ["count", "type"],
          "properties": { "count": { "type": "integer", "minimum": 1 }, "type": { "enum": ["none", "merchant", "issuer"] } }
        },
        "settlement_date": { "type": "string", "format": "date" },
        "fiscal_note": { "type": "string" }
      }
    }
  }
}
