{
  "$description": "goonersPAY design tokens (W3C Design Tokens Community Group format). Contrast pairs under $extensions are verified by tools/check.mjs.",
  "color": {
    "midnight": {
      "950": { "$type": "color", "$value": "#0B0F19", "$description": "Brand primary: trust and stability" }
    },
    "slate": {
      "50": { "$type": "color", "$value": "#F8FAFC" },
      "100": { "$type": "color", "$value": "#F1F5F9" },
      "300": { "$type": "color", "$value": "#CBD5E1" },
      "400": { "$type": "color", "$value": "#94A3B8" },
      "600": { "$type": "color", "$value": "#475569" },
      "700": { "$type": "color", "$value": "#334155" },
      "800": { "$type": "color", "$value": "#1E293B", "$description": "Brand secondary surface" },
      "900": { "$type": "color", "$value": "#111827" }
    },
    "mint": {
      "400": { "$type": "color", "$value": "#34D399" },
      "500": { "$type": "color", "$value": "#10B981", "$description": "Action and success: velocity" },
      "600": { "$type": "color", "$value": "#059669" },
      "700": { "$type": "color", "$value": "#047857" }
    },
    "amber": {
      "500": { "$type": "color", "$value": "#F59E0B", "$description": "Attention without alarm" },
      "700": { "$type": "color", "$value": "#B45309" }
    },
    "coral": {
      "400": { "$type": "color", "$value": "#FB7185", "$description": "Alerts and declines, calm rather than red" },
      "700": { "$type": "color", "$value": "#BE123C" }
    },
    "indigo": {
      "400": { "$type": "color", "$value": "#818CF8" },
      "700": { "$type": "color", "$value": "#4338CA" }
    },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "black": { "$type": "color", "$value": "#000000" }
  },
  "theme": {
    "dark": {
      "canvas": { "$type": "color", "$value": "{color.midnight.950}" },
      "surface": { "$type": "color", "$value": "{color.slate.900}" },
      "surface-raised": { "$type": "color", "$value": "{color.slate.800}" },
      "border": { "$type": "color", "$value": "{color.slate.700}" },
      "text-primary": { "$type": "color", "$value": "{color.slate.50}" },
      "text-secondary": { "$type": "color", "$value": "{color.slate.400}" },
      "action-fill": { "$type": "color", "$value": "{color.mint.500}" },
      "action-fill-pressed": { "$type": "color", "$value": "{color.mint.600}" },
      "on-action": { "$type": "color", "$value": "{color.midnight.950}" },
      "action-border": { "$type": "color", "$value": "{color.mint.500}" },
      "success-text": { "$type": "color", "$value": "{color.mint.400}" },
      "attention-text": { "$type": "color", "$value": "{color.amber.500}" },
      "attention-fill": { "$type": "color", "$value": "{color.amber.500}" },
      "on-attention": { "$type": "color", "$value": "{color.midnight.950}" },
      "alert-text": { "$type": "color", "$value": "{color.coral.400}" },
      "alert-fill": { "$type": "color", "$value": "{color.coral.400}" },
      "on-alert": { "$type": "color", "$value": "{color.midnight.950}" },
      "info-text": { "$type": "color", "$value": "{color.indigo.400}" },
      "focus-ring": { "$type": "color", "$value": "{color.indigo.400}" }
    },
    "light": {
      "canvas": { "$type": "color", "$value": "{color.slate.50}" },
      "surface": { "$type": "color", "$value": "{color.white}" },
      "surface-raised": { "$type": "color", "$value": "{color.slate.100}" },
      "border": { "$type": "color", "$value": "{color.slate.300}" },
      "text-primary": { "$type": "color", "$value": "{color.midnight.950}" },
      "text-secondary": { "$type": "color", "$value": "{color.slate.600}" },
      "action-fill": { "$type": "color", "$value": "{color.mint.500}" },
      "action-fill-pressed": { "$type": "color", "$value": "{color.mint.600}" },
      "on-action": { "$type": "color", "$value": "{color.midnight.950}" },
      "action-border": { "$type": "color", "$value": "{color.mint.700}" },
      "success-text": { "$type": "color", "$value": "{color.mint.700}" },
      "attention-text": { "$type": "color", "$value": "{color.amber.700}" },
      "attention-fill": { "$type": "color", "$value": "{color.amber.500}" },
      "on-attention": { "$type": "color", "$value": "{color.midnight.950}" },
      "alert-text": { "$type": "color", "$value": "{color.coral.700}" },
      "alert-fill": { "$type": "color", "$value": "{color.coral.400}" },
      "on-alert": { "$type": "color", "$value": "{color.midnight.950}" },
      "info-text": { "$type": "color", "$value": "{color.indigo.700}" },
      "focus-ring": { "$type": "color", "$value": "{color.indigo.700}" }
    },
    "sunlight": {
      "canvas": { "$type": "color", "$value": "{color.white}" },
      "surface": { "$type": "color", "$value": "{color.white}" },
      "surface-raised": { "$type": "color", "$value": "{color.slate.100}" },
      "border": { "$type": "color", "$value": "{color.black}" },
      "text-primary": { "$type": "color", "$value": "{color.black}" },
      "text-secondary": { "$type": "color", "$value": "{color.midnight.950}" },
      "action-fill": { "$type": "color", "$value": "{color.mint.500}" },
      "action-fill-pressed": { "$type": "color", "$value": "{color.mint.600}" },
      "on-action": { "$type": "color", "$value": "{color.black}" },
      "action-border": { "$type": "color", "$value": "{color.black}" },
      "success-text": { "$type": "color", "$value": "{color.mint.700}" },
      "attention-text": { "$type": "color", "$value": "{color.amber.700}" },
      "attention-fill": { "$type": "color", "$value": "{color.amber.500}" },
      "on-attention": { "$type": "color", "$value": "{color.black}" },
      "alert-text": { "$type": "color", "$value": "{color.coral.700}" },
      "alert-fill": { "$type": "color", "$value": "{color.coral.400}" },
      "on-alert": { "$type": "color", "$value": "{color.black}" },
      "info-text": { "$type": "color", "$value": "{color.indigo.700}" },
      "focus-ring": { "$type": "color", "$value": "{color.black}" }
    }
  },
  "size": {
    "touch-min": { "$type": "dimension", "$value": "48dp" },
    "keypad-key": { "$type": "dimension", "$value": "72dp" },
    "cta-height": { "$type": "dimension", "$value": "56dp" },
    "gutter": { "$type": "dimension", "$value": "16dp" },
    "grid": { "$type": "dimension", "$value": "4dp" }
  },
  "type": {
    "amount-display": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "56sp", "lineHeight": "64sp", "fontWeight": 700, "fontFeatures": "tnum" } },
    "title": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "22sp", "lineHeight": "28sp", "fontWeight": 600 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "16sp", "lineHeight": "24sp", "fontWeight": 400 } },
    "label": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "14sp", "lineHeight": "20sp", "fontWeight": 600 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "12sp", "lineHeight": "16sp", "fontWeight": 500 } }
  },
  "motion": {
    "approve": { "$type": "duration", "$value": "400ms" },
    "standard": { "$type": "duration", "$value": "200ms" },
    "easing-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "$extensions": {
    "goonerspay.contrastPairs": [
      { "theme": "dark", "fg": "text-primary", "bg": "canvas", "min": 4.5, "use": "Body text" },
      { "theme": "dark", "fg": "text-secondary", "bg": "surface-raised", "min": 4.5, "use": "Secondary text on cards" },
      { "theme": "dark", "fg": "on-action", "bg": "action-fill", "min": 4.5, "use": "CTA label" },
      { "theme": "dark", "fg": "action-fill", "bg": "canvas", "min": 3, "use": "CTA shape vs background (non-text)" },
      { "theme": "dark", "fg": "success-text", "bg": "canvas", "min": 4.5, "use": "Positive amounts" },
      { "theme": "dark", "fg": "attention-text", "bg": "canvas", "min": 4.5, "use": "Warnings (battery, delays)" },
      { "theme": "dark", "fg": "alert-text", "bg": "canvas", "min": 4.5, "use": "Security alerts, declines" },
      { "theme": "dark", "fg": "info-text", "bg": "canvas", "min": 4.5, "use": "Links, info" },
      { "theme": "light", "fg": "text-primary", "bg": "canvas", "min": 4.5, "use": "Body text" },
      { "theme": "light", "fg": "text-secondary", "bg": "surface", "min": 4.5, "use": "Secondary text" },
      { "theme": "light", "fg": "on-action", "bg": "action-fill", "min": 4.5, "use": "CTA label" },
      { "theme": "light", "fg": "action-border", "bg": "canvas", "min": 3, "use": "CTA outline vs background (non-text)" },
      { "theme": "light", "fg": "success-text", "bg": "surface", "min": 4.5, "use": "Positive amounts" },
      { "theme": "light", "fg": "attention-text", "bg": "surface", "min": 4.5, "use": "Warnings" },
      { "theme": "light", "fg": "on-attention", "bg": "attention-fill", "min": 4.5, "use": "Warning banner text" },
      { "theme": "light", "fg": "alert-text", "bg": "surface", "min": 4.5, "use": "Security alerts, declines" },
      { "theme": "light", "fg": "on-alert", "bg": "alert-fill", "min": 4.5, "use": "Alert banner text" },
      { "theme": "light", "fg": "info-text", "bg": "surface", "min": 4.5, "use": "Links, info" },
      { "theme": "sunlight", "fg": "text-primary", "bg": "canvas", "min": 7, "use": "Body text (AAA)" },
      { "theme": "sunlight", "fg": "on-action", "bg": "action-fill", "min": 7, "use": "CTA label (AAA)" },
      { "theme": "sunlight", "fg": "action-border", "bg": "canvas", "min": 3, "use": "CTA outline (non-text)" },
      { "theme": "sunlight", "fg": "success-text", "bg": "canvas", "min": 4.5, "use": "Positive amounts" },
      { "theme": "sunlight", "fg": "alert-text", "bg": "canvas", "min": 4.5, "use": "Alerts" }
    ],
    "goonerspay.rejected": [
      { "fg": "#FFFFFF", "bg": "#10B981", "min": 4.5, "why": "White label on mint fails AA" },
      { "fg": "#FFFFFF", "bg": "#059669", "min": 4.5, "why": "Still fails AA for normal text" },
      { "fg": "#10B981", "bg": "#FFFFFF", "min": 4.5, "why": "Mint text on white is illegible" },
      { "fg": "#F59E0B", "bg": "#FFFFFF", "min": 4.5, "why": "Amber text on white is illegible" }
    ]
  }
}
