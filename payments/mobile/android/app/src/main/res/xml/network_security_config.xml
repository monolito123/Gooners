<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: TLS only, system trust anchors only (pinning is added with the production endpoints). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
