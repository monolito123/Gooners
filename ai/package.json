{
  "name": "gooners-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Gooners AI: local multi-modal studio (text, image, video, app builder) running entirely in the browser with WebGPU/WASM.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node --test --test-reporter=spec test/e2e/app.test.mjs",
    "check:sd": "node --experimental-strip-types --no-warnings scripts/sd-cpu-check.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.87",
    "@tailwindcss/browser": "^4.3.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "motion": "^14.10.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@webgpu/types": "^0.1.74",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
